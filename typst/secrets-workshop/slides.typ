#slide[
  = Prompt backends
  #v(0.5em)
  #set text(size: 19pt)

  - Ask!
  - Given `secret-name`, `prompt-name`, `prompt-type`, `prompt-label`, and `prompt-description`; writes to `$out`.
  #show: later
  ```nix
      {
        secrets.backends.prompt.simple.ask = pkgs:
          pkgs.writeScript "simple-prompt" ''
            #!/bin/sh
            export PATH="${lib.makeBinPath [ pkgs.coreutils ]}"
            if [[ "$3" == "line" ]]; then
              read -rp "$4: " text
              echo -n "$text" > "$out"
            # ...
          '';
      }
  ```
]

#slide[
  #set align(horizon)
  = Store backends
  #v(1em)
  #set text(size: 18pt)

  - Actual secret storage.
  - Can also handle deployment (when needed).
  // - `secrets.backends.store.simple.<script>`
]

#slide[
  = Get
  #v(0.5em)
  #set text(size: 18pt)

  - Takes a secret and file name, writes the content to `$out`

  #v(2em)
  #show: later
  = Set
  #v(0.5em)
  #set text(size: 18pt)

  - Takes a secret and file name, writes the content of `$in` to the secret.

  #v(2em)
  #show: later
  = List
  #v(0.5em)
  #set text(size: 18pt)

  - Produces a list of all the `secret, file` pairs stored by the backend.
  - Some might be stale — useful for garbage collection!
]

#slide[
  #set align(horizon)
  = Delete
  #v(1em)
  #set text(size: 20pt)

  - Deletes the given `secret, file` pair.

  #show: later
  #v(1em)
  = Fixup
  #v(1em)
  #set text(size: 20pt)

  - Invoked for every secret (on each run).
]

