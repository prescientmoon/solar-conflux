#slide[
  #set text(size: 25pt)
  = The structure of a secret
  #v(0.5em)
  #set text(size: 22pt)

  // Think of public / private keys as an example of a secret that holds more than one!
  - A secret holds a non-empty set of files.
  - Backends!

  #show: later
  #v(0.5em)
  #set align(horizon + center)
  #set text(size: 20pt)
  ```nix
  {
    secrets.store.cat = {
      backend = "plain";
      files.greeting = { };
    };
  }
  ```
]

#slide[
  #set text(size: 25pt)
  = Generators
  #v(1em)
  #set text(size: 20pt)

  // Example usecases: machine IDs, SSH keys, etc
  Secrets can be generated by a script, no way!

  #set text(size: 20pt)
  #v(1em)
  #set align(horizon + center)
  ```nix
  {
    secrets.store.cat = {
      # ...
      generate = pkgs: pkgs.writeScript "gen-user" ''
        #!/bin/sh
        echo "Meow~" > "$out/greeting"
      '';
    };
  }
  ```
  // - The script writes the value of the secret to $out
  // - This is not simply a script!
  // - Explain host/target system
  // - Language agnostic
]

#slide[
  #set text(size: 25pt)
  = Dependencies :O
  #v(1em)
  #set text(size: 20pt)

  Secrets can depend on each other!

  #v(1em)
  #set align(horizon + center)
  #set text(size: 18pt)
  ```nix
  {
    secrets.store.cow = {
      dependencies = [ "cat" ];
      files.cow-greeting = { };
      generate = pkgs: pkgs.writeScript "gen-derived" ''
        #!/bin/sh
        export PATH="${lib.makeBinPath [ pkgs.coreutils pkgs.cowsay ]}"
        cat $in/cat/greeting | cowsay > $out/cow-greeting
      '';
    };
  }
  ```
  // - Read from $in
  // - Magic
  // - Dependencies work across Nixcon
]

#slide[
  #set text(size: 25pt)
  = Prompts?!
  #v(1em)
  #set text(size: 20pt)

  User input? It's more likely than you think!

  #show: later
  #set text(size: 18pt)
  #set align(horizon + center)
  ```nix
  {
    secrets.store.user = {
      prompts.name = {
        backend = "simple";
        label = "Your name";
        description = "The person to address the greeting to";
        type = "line";
      };

      # ...
    };
  }
  ```
]

#slide[
  #set text(size: 25pt)
  = Prompts?! (2)
  #v(1em)
  #set text(size: 20pt)

  User input? It's more likely than you think!

  #v(1em)
  #set text(size: 18pt)
  #set align(horizon + center)
  ```nix
  {
    secrets.store.user = {
      # ...
      files.greeting = { };
      generate = pkgs: pkgs.writeScript "gen-user" ''
        #!/bin/sh
        export PATH="${lib.makeBinPath [ pkgs.coreutils ]}"
        echo "Hi! My name is $(cat "$prompts/name")." > "$out/greeting"
      '';
    };
  }
  ```
]

